# ------------------------------------------------------------------
# Production env. Copy to .env.production na VPS:
#   cp .env.production.example .env.production
# NEVER commit .env.production (gitignored via .env.*).
# ------------------------------------------------------------------

# --- Backend URL (OBRIGATÓRIA) ---
# Para onde o servidor Node do container (server/index.mjs) encaminha /api/* —
# o navegador chama /api na própria origem — e de onde busca curso, notícia e
# cotações para as meta OpenGraph. Não há valor padrão: sem ela o servidor não
# sobe e o log diz por quê. No Coolify, defina-a nas variáveis de CADA ambiente
# (staging e produção), apontando para a API daquele ambiente.
# Deve ser acessível DE DENTRO do container web (não localhost).
# Recomendado: nome do container da API na rede traefik-crga (tráfego interno,
# não passa pela internet e não expõe a porta 3000).
# Requer que a stack do backend esteja rodando na mesma rede externa.
BACKEND_URL=http://sindicato_api:3000
# Fallback (API fora da rede docker / debug): use o IP da máquina, nunca 127.0.0.1
# BACKEND_URL=http://2.24.80.138:3000

# --- Domínio ou IP do frontend (usado nas labels do Traefik) ---
# Sem domínio: coloque o IP da VPS
# Com domínio: coloque o domínio (ex: sindicatorural.com.br)
DOMAIN=2.24.80.138
